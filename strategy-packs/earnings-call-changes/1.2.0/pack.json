      "rolloverGenerationOnChange": true
    },
    {
      "key": "materialityThreshold",
      "kind": "bounded_enum",
      "label": "Materiality threshold",
      "description": "Deterministic minimum score required before an accepted analysis can alert.",
      "required": true,
      "allowedValues": [
        "threshold_50",
        "threshold_65",
        "threshold_80"
      ],
      "default": "threshold_65",
      "mutableAfterInstall": true,
      "pauseManagedMonitorsOnChange": true,
      "rolloverGenerationOnChange": true
