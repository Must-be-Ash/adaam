      "catalogId": "sec-issuers",
      "catalogRevision": 1,
      "catalogDigest": "a245bb50765e41bc27ae9b1df6eabab3bf70d6c9cc4aeebbecf4f2babd3ee95e",
      "default": ["0000789019"],
      "minimumItems": 1,
      "maximumItems": 8,
      "mutableAfterInstall": true,
      "pauseManagedMonitorsOnChange": true,
      "rolloverGenerationOnChange": true
    },
    {
      "key": "materialityThreshold",
      "kind": "bounded_enum",
      "label": "Materiality threshold",
      "description": "Deterministic minimum score required before an accepted analysis can alert.",
      "required": true,
      "allowedValues": ["threshold_50", "threshold_65", "threshold_80"],
      "default": "threshold_65",
      "mutableAfterInstall": true,
      "pauseManagedMonitorsOnChange": true,
      "rolloverGenerationOnChange": true
    }
  ],
  "skills": [
