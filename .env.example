# Model access (or link the project with `eve link` to use Vercel AI Gateway)
AI_GATEWAY_API_KEY=

# Financial Modeling Prep
FMP_API_KEY=

# Coinbase for Agents (Advanced Trade)
# Scope this key to a dedicated, minimally funded spot portfolio. The secret may
# be an escaped PEM value; keep it quoted exactly as downloaded.
COINBASE_KEY_ID=
COINBASE_KEY_SECRET=
# Comma-separated private-channel principal IDs returned by
# coinbase_access_status. Use the complete value, including its channel prefix,
# for example: telegram:123456789 or imessage:+15551234567. This allowlist
# protects Coinbase capabilities only; it is not Eve's general owner allowlist.
# The iMessage number does not need to match a Coinbase account phone.
COINBASE_ALLOWED_PRINCIPALS=

# SEC fair-access identity, for example:
# adaam/0.1 your-team-contact@example.com
SEC_USER_AGENT=

# Telegram BotFather credentials and webhook configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Dynamic event-trigger storage. Vercel injects these from the isolated Upstash
# integration; do not copy real values into source control. Photon Chat SDK state
# additionally requires the provider's TLS Redis connection URL.
KV_REST_API_URL=
KV_REST_API_TOKEN=
REDIS_URL=

# Public artifact storage. Provision and connect the store with:
# vercel blob create-store eve-artifacts --access public --yes
# Vercel injects the read/write token; BLOB_STORE_ID is used when the project
# authenticates Blob operations through Vercel OIDC instead.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# App-scoped identifier created by `eve add channel/photon-imessage`, for example
# photon/eve-agent. This is not a secret, but every fork must use its own
# connector. iMessage credentials remain in Vercel Connect.
PHOTON_CONNECTOR_ID=

# Independent workspace-runtime rollout flags. New surfaces fail closed unless
# set to exactly 1. Keep legacy trigger creation enabled (the default) until
# workspace monitor writes are enabled. See the Spec 1 feature-flag contract.
EVE_WORKSPACE_STATE_ENABLED=0
EVE_WORKSPACE_MONITOR_WRITES_ENABLED=0
EVE_WORKSPACE_DISPATCH_ENABLED=0
EVE_WORKSPACE_PAID_RESEARCH_ENABLED=0
EVE_PHOTON_WORKSPACE_ALERTS_ENABLED=0
EVE_WORKSPACE_SOURCE_EVENTS_ENABLED=0
EVE_LEGACY_TRIGGER_CREATION_ENABLED=1
