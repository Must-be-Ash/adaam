# Model access (or link the project with `eve link` to use Vercel AI Gateway)
AI_GATEWAY_API_KEY=

# Financial Modeling Prep
FMP_API_KEY=

# Public Commentary Signals (Spec 4C). Keep these server-side. The X connector
# uses the reviewed user timeline and exact lifecycle checks; Exa is optional
# metadata-only corroboration and must not receive exact X quotes or private
# workspace context.
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
EXA_API_KEY=
# Independent 32-byte base64 AES key and non-secret KMS/key identifier for the
# deletable X payload class. Required only when commentary execution is enabled.
EVE_PUBLIC_COMMENTARY_EVIDENCE_KEY_BASE64=
EVE_PUBLIC_COMMENTARY_EVIDENCE_KEY_REFERENCE=

# Optional credentials reserved for separately reviewed future integrations.
# Their presence does not grant scheduled workers a capability by itself.
XAI_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=

# Coinbase for Agents (Advanced Trade)
# Scope this key to a dedicated, minimally funded spot portfolio. The secret may
# be an escaped PEM value; keep it quoted exactly as downloaded.
COINBASE_KEY_ID=
COINBASE_KEY_SECRET=
# Comma-separated private-channel principal IDs returned by
# coinbase_access_status. Use the complete value, including its channel prefix,
# for example: telegram:123456789 or imessage:+15551234567. This allowlist
# protects Coinbase capabilities only; it is not Eve's general owner allowlist.
# The iMessage number does not need to match a Coinbase account phone.
COINBASE_ALLOWED_PRINCIPALS=

# SEC fair-access identity, for example:
# adaam/0.1 your-team-contact@example.com
SEC_USER_AGENT=

# Telegram BotFather credentials and webhook configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Dynamic event-trigger storage. Vercel injects these from the isolated Upstash
# integration; do not copy real values into source control. Photon Chat SDK state
# additionally requires the provider's TLS Redis connection URL.
KV_REST_API_URL=
KV_REST_API_TOKEN=
REDIS_URL=

# Public artifact storage. Provision and connect the store with:
# vercel blob create-store eve-artifacts --access public --yes
# Vercel injects the read/write token; BLOB_STORE_ID is used when the project
# authenticates Blob operations through Vercel OIDC instead.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Private scratch storage for encrypted/raw hybrid-evidence artifacts. Keep this
# separate when BLOB_READ_WRITE_TOKEN points at a public application store.
# Connect a private Blob store with the EVE_HYBRID_EVIDENCE_ prefix so Vercel
# injects EVE_HYBRID_EVIDENCE_READ_WRITE_TOKEN.
EVE_HYBRID_EVIDENCE_READ_WRITE_TOKEN=

# App-scoped identifier created by `eve add channel/photon-imessage`, for example
# photon/eve-agent. This is not a secret, but every fork must use its own
# connector. iMessage credentials remain in Vercel Connect.
PHOTON_CONNECTOR_ID=

# Independent workspace-runtime rollout flags. New surfaces fail closed unless
# set to exactly 1. Keep legacy trigger creation enabled (the default) until
# workspace monitor writes are enabled. See the Spec 1 feature-flag contract.
EVE_WORKSPACE_STATE_ENABLED=0
EVE_WORKSPACE_MONITOR_WRITES_ENABLED=0
EVE_WORKSPACE_DISPATCH_ENABLED=0
# Deployment admission limits. The daily ceiling cannot exceed the preserved
# legacy global limit of 500; workspace policies may only tighten these caps.
EVE_WORKSPACE_GLOBAL_CONCURRENT_WORKERS=8
EVE_WORKSPACE_GLOBAL_RUNS_PER_DAY=500
EVE_WORKSPACE_PAID_RESEARCH_ENABLED=0
EVE_PHOTON_WORKSPACE_ALERTS_ENABLED=0
EVE_WORKSPACE_SOURCE_EVENTS_ENABLED=0
EVE_LEGACY_TRIGGER_CREATION_ENABLED=1

# Versioned strategy packs. Each surface requires workspace state; mutations
# also require monitor writes, and managed dispatch also requires both pack
# runtime composition and workspace dispatch. Values other than exactly 1 are
# disabled. Keep all pack flags off until the corresponding Spec 2 rollout gate.
EVE_STRATEGY_PACK_CATALOG_ENABLED=0
EVE_STRATEGY_PACK_MUTATIONS_ENABLED=0
EVE_STRATEGY_PACK_RUNTIME_ENABLED=0
EVE_STRATEGY_PACK_MANAGED_DISPATCH_ENABLED=0

# Public-source adapter acquisition. The shared execution gate and individual
# SEC and House cutovers default off. Disabling SEC keeps the reviewed legacy
# SEC workspace-worker path as the explicit rollback route; disabling House
# prevents House acquisition.
EVE_PUBLIC_SOURCE_ACQUISITION_ENABLED=0
EVE_PUBLIC_SOURCE_PROJECTIONS_ENABLED=0
EVE_SEC_PUBLIC_SOURCE_ADAPTER_ENABLED=0
EVE_HOUSE_PUBLIC_SOURCE_ADAPTER_ENABLED=0
# Public-commentary source, optional corroboration, and strategy execution are
# independent child gates. Keep all three off until their later rollout sprints.
EVE_X_PUBLIC_STATEMENT_SOURCE_ENABLED=0
EVE_OFFICIAL_WEB_STATEMENT_SOURCE_ENABLED=0
EVE_EXA_CORROBORATION_ENABLED=0
EVE_INVERSE_CRAMER_EXECUTION_ENABLED=0
# Congressional Signals evaluation remains independently fail-closed even when
# the House adapter is enabled. Sprint 5 owns production rollout of this flag.
EVE_CONGRESSIONAL_SIGNALS_EXECUTION_ENABLED=0

# Hybrid public-evidence reasoning. Both child paths require the parent plus
# workspace state and dispatch. Partial configuration fails closed; values
# other than exactly 1 are disabled. Keep all three off until a reviewed rollout.
EVE_HYBRID_EVIDENCE_ENABLED=0
EVE_HYBRID_EXTRACTION_RECOVERY_ENABLED=0
EVE_HYBRID_SEMANTIC_REASONING_ENABLED=0
# Task-aware routing is configured independently from the rollout flags. The
# Spec 4B.1-qualified fast model uses provider-default reasoning; semantic
# interpretation retains the accepted GPT-5.4/high route.
EVE_HYBRID_FAST_MODEL_ID=anthropic/claude-haiku-4.5
EVE_HYBRID_FAST_MODEL_REASONING=provider-default
EVE_HYBRID_FRONTIER_MODEL_ID=openai/gpt-5.4
EVE_HYBRID_FRONTIER_MODEL_REASONING=high
EVE_STRATEGY_PACK_WORKER_MODEL_ID=openai/gpt-5.4
# Independent base64url HMAC secret (32+ random bytes) for expiring single-job
# hybrid worker claims. The source-recovery allowlist must include the fast
# extractor and a distinct independent-OCR model; frontier is excluded from OCR.
# The remaining values are deployment-wide Lane A ceilings.
EVE_HYBRID_EVIDENCE_AUTH_SECRET=
EVE_HYBRID_SOURCE_RECOVERY_MODEL_IDS=anthropic/claude-haiku-4.5,zai/glm-5.3-flash
EVE_HYBRID_SOURCE_RECOVERY_CONCURRENT_WORKERS=2
EVE_HYBRID_SOURCE_RECOVERY_INPUT_TOKENS_PER_DAY=100000
EVE_HYBRID_SOURCE_RECOVERY_OUTPUT_TOKENS_PER_DAY=20000
EVE_HYBRID_SOURCE_RECOVERY_PAID_PER_CALL=1.00
EVE_HYBRID_SOURCE_RECOVERY_PAID_PER_DAY=10.00
EVE_HYBRID_SOURCE_RECOVERY_PAID_PER_MONTH=100.00

# Deployment-wide owner authorization. Keep real Photon principal IDs and the
# base64url HMAC secret in encrypted deployment configuration, never source.
# The owner ID is a stable opaque deployment-local identifier (not an email,
# phone number, or provider principal). Separate multiple principals with commas.
# Changing the HMAC secret changes aliases and requires a reviewed migration.
EVE_DEPLOYMENT_OWNER_ID=
EVE_PHOTON_OWNER_PRINCIPALS=
EVE_OWNER_ALIAS_HMAC_SECRET=
# Independent base64url secret (32+ random bytes) used only to sign bounded
# workspace-worker runtime claims. Do not reuse the owner-alias HMAC secret.
EVE_WORKSPACE_RUNTIME_AUTH_SECRET=
