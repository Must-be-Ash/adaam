# Model access (or link the project with `eve link` to use Vercel AI Gateway)
AI_GATEWAY_API_KEY=

# Financial Modeling Prep
FMP_API_KEY=

# SEC fair-access identity, for example:
# earnings-call-analyser/0.1 your-team-contact@example.com
SEC_USER_AGENT=

# Telegram BotFather credentials and webhook configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Dynamic event-trigger storage. Vercel injects these from the isolated Upstash
# integration; do not copy real values into source control.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# iMessage credentials are held by the linked Vercel Connect Photon connector;
# no Photon project secret belongs in this file.
