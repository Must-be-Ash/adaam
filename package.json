{
  "name": "earnings-call-analyser",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#coinbase-eval-fixture": "./agent/lib/coinbase-eval-fixture.ts",
    "#evals/*": "./evals/*",
    "#mcp-tool-result": "./agent/lib/mcp-tool-result.ts",
    "#photon-approval-store": "./agent/lib/photon-approval-store.ts"
  },
  "scripts": {
    "prepare:coinbase": "node scripts/embed-coinbase-cli.mjs",
    "prebuild": "npm run prepare:coinbase && npm run verify:context && npm run verify:approvals && npm run verify:sessions && npm run verify:workspaces && node scripts/prepare-next-build.mjs",
    "predev": "npm run prepare:coinbase",
    "pretypecheck": "npm run prepare:coinbase",
    "build": "next build",
    "build:agent": "eve build",
    "dev": "next dev",
    "dev:agent": "eve dev",
    "eval:coinbase": "node scripts/run-coinbase-evals.mjs",
    "start": "next start",
    "typecheck": "tsc",
    "verify:approvals": "node scripts/verify-photon-approval.mjs",
    "verify:approvals:redis": "node scripts/verify-photon-approval-redis.mjs",
    "verify:context": "node scripts/verify-mcp-tool-result.mjs",
    "verify:sessions": "node scripts/verify-photon-session.mjs",
    "verify:workspaces": "node scripts/verify-photon-workspaces.mjs",
    "verify:workspaces:redis": "node scripts/verify-photon-workspaces-redis.mjs"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.29",
    "@chat-adapter/state-redis": "^4.37.0",
    "@coinbase/coinbase-cli": "0.0.4",
    "@photon-ai/chat-adapter-imessage": "^3.2.0",
    "@upstash/redis": "^1.38.2",
    "@vercel/connect": "^0.6.1",
    "ai": "^7.0.38",
    "chat": "^4.37.0",
    "clsx": "^2.1.1",
    "eve": "^0.33.0",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.x",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "just-bash": "^3.2.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "ai": "^7.0.38"
  },
  "engines": {
    "node": "24.x"
  }
}
